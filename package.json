{
  "name": "diary-blog",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "零依赖的 Markdown 个人博客：只写 article/ 里的文章，GitHub Actions 自动构建并发布到 GitHub Pages",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:dist": "node scripts/build.mjs --out dist",
    "preview:dist": "node scripts/serve.mjs --out dist",
    "new": "node scripts/new-post.mjs",
    "check": "node scripts/check.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
